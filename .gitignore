# Local models, recordings, and generated data
# Model binaries remain local by default. The competition MoveNet runtime asset,
# browser MediaPipe task and directory layout documentation are tracked explicitly.
models/*
!models/README.md
!models/runtime/
!models/trained/
!models/vendor/
models/runtime/*
!models/runtime/movenet/
!models/runtime/mediapipe/
models/trained/*
!models/trained/posture/
!models/trained/fall/
models/vendor/*
!models/vendor/.gitkeep
models/runtime/movenet/*
!models/runtime/movenet/README.md
!models/runtime/movenet/movenet_lightning_f16_v4.tflite
models/runtime/mediapipe/*
!models/runtime/mediapipe/.gitkeep
models/trained/posture/*
!models/trained/posture/.gitkeep
models/trained/fall/*
!models/trained/fall/.gitkeep
recordings/
# Training/reference datasets are local assets. Keep only the root inventory
# document in Git; videos, keypoints, annotations and source archives remain local.
data/*
!data/README.md
artifacts/
Downloads*.zip

