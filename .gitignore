*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Local models, recordings, and generated data
models/
recordings/
data/raw/
artifacts/
Downloads*.zip

# Local environment
.env
.env.*
!.env.example
node_modules/

# CodeGraph local index
.codegraph/
**/*mp4
**/*jpg
!frontend/public/scenes/
!frontend/public/scenes/*.jpg
# Claude Code local state (agent worktrees, session settings)
.claude/

# MediaPipe wasm 由 predev/prebuild 从 node_modules 拷贝（模型 .task 入库）
frontend/public/mediapipe/wasm/
# LiteRT.js wasm 同样由 predev/prebuild 从 node_modules 生成
frontend/public/litert/wasm/
# 跌倒问询预置语音优先由 predev/prebuild 从已审计的 examples 资产生成；
# Vercel 仅上传 frontend 时保留这一份同哈希的发布回退资产。
frontend/public/voice/*
!frontend/public/voice/fall_check_in.m4a
# Vercel CLI 本地项目绑定与拉取的环境配置
frontend/.vercel/

# Derived keypoint copies used for local analysis (regenerate with git show)
.scratch/posture-classifier-theory/data/
