FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home reme

WORKDIR /app

COPY pyproject.toml README.md ./
COPY backend/ ./backend/
RUN python -m pip install --no-cache-dir ".[pose]"

RUN mkdir -p /app/artifacts /app/models \
    && chown -R reme:reme /app/artifacts /app/models

USER reme
EXPOSE 8770

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8770/api/health', timeout=2).read()"

CMD ["python", "-m", "reme.runtime.server", "--host", "0.0.0.0", "--port", "8770", "--input-adapter", "c_ws_server", "--browser-input-mode", "jpeg"]
